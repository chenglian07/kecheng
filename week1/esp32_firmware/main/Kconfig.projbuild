menu "Week1 IMU Collector Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "YOUR_WIFI_SSID"
        help
            WiFi 网络名称

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "YOUR_WIFI_PASSWORD"
        help
            WiFi 网络密码

    config SERVER_URL
        string "VPS Backend Server URL"
        default "http://127.0.0.1:8000"
        help
            VPS 后端地址，如 http://1.2.3.4:8000

    config DEVICE_ID
        string "Device ID (本组唯一标识)"
        default "group_01"
        help
            每组独立的设备 ID，用于区分不同设备

    config UPLOAD_INTERVAL_MS
        int "Upload Interval (milliseconds)"
        default 5000
        range 1000 60000
        help
            IMU 数据上传周期，单位毫秒

endmenu