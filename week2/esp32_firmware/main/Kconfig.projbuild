menu "Week1 IMU Collector Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "YOUR_WIFI_SSID"
        help
            WiFi 网络名称

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "YOUR_WIFI_PASSWORD"
        help
            WiFi 网络密码

    config SERVER_URL
        string "局域网服务器地址"
        default "http://10.1.41.154:8000"
        help
            本机电脑局域网 IP，ESP32 和电脑须在同一 WiFi

    config DEVICE_ID
        string "Device ID (本组唯一标识)"
        default "group_01"
        help
            每组独立的设备 ID，用于区分不同设备

    config UPLOAD_INTERVAL_MS
        int "Upload Interval (milliseconds)"
        default 5000
        range 200 60000
        help
            IMU 数据上传周期，单位毫秒

endmenu