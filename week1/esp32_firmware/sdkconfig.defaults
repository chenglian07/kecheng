# sdkconfig.defaults - ESP32-S3-EYE 第1周配置
# WiFi
CONFIG_ESP_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_ESP_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# 后端服务器地址（VPS公网IP或域名）
CONFIG_SERVER_URL="http://YOUR_VPS_IP:8000"

# 设备ID（每组唯一，请修改为自己的组号）
CONFIG_DEVICE_ID="group_01"

# 上传周期（毫秒）
CONFIG_UPLOAD_INTERVAL_MS=5000

# Flash 大小
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# 分区表
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# 日志级别
CONFIG_LOG_DEFAULT_LEVEL_INFO=y